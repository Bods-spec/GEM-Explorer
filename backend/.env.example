# COPY to .env and keep .env private. Never upload keys to GitHub or chat.
PORT=3000

# Supabase Project URL (Connect / Project Settings) and SERVER-ONLY secret API key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_YOUR_SECRET_KEY

# AI is optional and separate from Supabase. Requires a paid API key and verified files.
OPENAI_API_KEY=
OPENAI_VECTOR_STORE_ID=
OPENAI_MODEL=gpt-4.1-mini
